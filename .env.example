# AWS S3 (optional — for clip backup/gallery)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PUBLIC_BUCKET=your-public-bucket-name

# YouTube cookies (optional — paste Netscape-format cookies to bypass bot detection)
# YOUTUBE_COOKIES=...

# Google OAuth (cloud/billing mode only). When logging in through a proxy whose
# Host header doesn't match a Google-registered URI (e.g. local dev via the Vite
# proxy), pin the callback explicitly:
# OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# FRONTEND_URL=http://localhost:5175

# Local dev: show the full pipeline logs (yt-dlp/ffmpeg/debug) in the UI even
# when running in paid mode (BILLING_ENABLED). Cloud/prod leaves this unset.
# DEBUG_LOGS=true

# Pre-flight quality gate: warn before processing a YouTube source below this
# height (720p default; 0 disables). Only applies to URL sources.
# QUALITY_GATE_MIN_HEIGHT=720

# Whisper transcription model (main pipeline). "small" is better than "base" on
# non-English audio; "base" is faster. device/compute for GPU tuning.
# Prod GPU: WHISPER_MODEL=large-v3-turbo WHISPER_DEVICE=cuda WHISPER_COMPUTE=float16
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8

# --- Adaptive transcription (asr_quality.py) --------------------------------
# One probe, one pass, one repair. ~75 seconds are decoded first to decide
# WHICH model transcribes the video; the video is then transcribed once with
# it; only a transcript judged unusable is transcribed again, once.
#
# This replaced an escalation ladder that transcribed the whole video up to
# three times. On a 9.5-minute Hinglish stand-up that was ~16 minutes of CPU
# per pass, the third model load was OOM-killed with the second still resident
# (exit -9), and the job delivered no clips at all after ~50 minutes — while
# the transcript it was escalating away from was already good enough to cut
# from.
#
# ASR_PROBE=0 skips the probe and transcribes straight with WHISPER_MODEL.
# It is skipped automatically when WHISPER_MODEL is already the strong model
# (the GPU deploy above), so that configuration is unchanged by any of this.
# ASR_PROBE=1
# ASR_PROBE_SLICES=3
# ASR_PROBE_SECONDS=25
#
# The stronger model: what the probe upgrades TO, and what the one repair pass
# uses. large-v3-turbo is full large-v3 multilingual TRANSCRIPTION accuracy
# with 4 decoder layers instead of 32, which is what makes it affordable on
# CPU. Set empty to disable both the upgrade and the repair.
# WHISPER_RETRY_MODEL=large-v3-turbo
#
# ASR_QUALITY_GATE=0 scores nothing and never blocks a job (emergency switch).
# ASR_AUTO_RETRY=0 keeps the scoring and the clear error, but never retries.
# ASR_QUALITY_GATE=1
# ASR_AUTO_RETRY=1
#
# Verdict thresholds on the 0-100 score: >= GOOD accept, >= BAD retry, below
# BAD refuse the job with a transcription-quality error.
# ASR_QUALITY_GOOD_SCORE=70
# ASR_QUALITY_BAD_SCORE=40
#
# Is the transcribed text real language? auto (default) | 1 (always) | 0 (never).
# Deterministic signals measure STRUCTURE, and a model transcribing a language
# it cannot handle writes structurally PERFECT nonsense: large-v3-turbo scored
# avg_logprob -0.29 and 100/100 on a transcript that was a third invented.
# Only reading the words catches that (asr_semantic.py), and it reads samples
# spread across the WHOLE timeline — the corruption in the real job lived in
# the middle, where a first/last sample never looks.
#
#   0     never read. Structure decides alone.
#   auto  read only when justified: a GOOD verdict resting on structure alone
#         (avg_logprob below the suspect line), an attempt that exists BECAUSE
#         an earlier one was gibberish (it must prove it fixed that), and the
#         last reprieve before a job is refused. A clean video pays nothing.
#   1     read every ASR result, once per attempt.
#
# ASR_QUALITY_GEMINI=auto
# ASR_QUALITY_LOGPROB_SUSPECT=-0.60
#
# Sampling for the representative read, and for the dense second pass that only
# runs once a transcript is already known to be mixed (it maps WHERE the damage
# is, so clip selection can avoid it instead of discarding the whole video).
# ASR_SEMANTIC_SAMPLES=6
# ASR_SEMANTIC_SAMPLE_SECONDS=25
# ASR_SEMANTIC_REGION_SECONDS=45
#
# Share of examined speech that must read correctly for a GOOD verdict, and the
# floor below which the transcript is BAD rather than PARTIAL.
# ASR_SEMANTIC_GOOD_SHARE=0.80
# ASR_SEMANTIC_BAD_SHARE=0.25
#
# The retry KEEPS the language attempt 1 detected, when attempt 1 was at least
# this sure of it. Measured: whisper-small detected Hindi at 89%, and
# large-v3-turbo re-detecting on its own decided English at 96% and emitted an
# English TRANSLATION of the Hindi audio (whisper does that once the language
# token is wrong, even with task=transcribe). That scores 99/100 because it is
# fluent English, so no quality signal can catch it. Below this confidence the
# detection may itself be the fault, and the stronger model decides again.
# ASR_PIN_LANGUAGE_ABOVE=0.5
#
# Windows sampled before committing to a language. faster-whisper's default of
# 1 lets the first 30 seconds (applause, music, an English intro) decide the
# language for the whole file, and a wrong choice there garbles everything.
# WHISPER_LANG_DETECT_SEGMENTS=4
#
# How many whisper models stay resident. 1 because the probe picks the right
# model up front, so keeping a second one warm buys little — and two large
# models resident on a CPU box is what the OOM killer ends. Raise it only
# where the RAM is known to exist.
# WHISPER_MODEL_CACHE=1

# An over-long Candidate Finder proposal is narrowed to the best complete
# section inside it before being rejected. On the real Hinglish run three of
# four proposals were discarded for length alone (110.9s, 95.3s, 117.2s) and
# the job produced nothing. Set to 0 to go back to rejecting them outright.
# MEANINGFUL_REPAIR_OVERLONG=1

# Transcription backend: whisper (default) | parakeet. Parakeet (NVIDIA
# parakeet-tdt-0.6b-v3 via onnx-asr, GPU image only) is ~2x faster than
# whisper-turbo-GPU and auto-falls-back to whisper on errors or languages
# outside its 25 European ones.
# TRANSCRIBE_BACKEND=whisper

# Concurrent GPU transcriptions (parakeet or whisper-on-cuda). Keep 1.
# ASR_GPU_CONCURRENCY=1

# Video encoder for all ffmpeg encodes: x264 (default) | nvenc | auto.
# auto probes h264_nvenc once at startup and falls back to x264 if unusable.
# FFMPEG_ENCODER=x264

# Product analytics (optional, off by default). Both are read by the dashboard
# at BUILD time. Leave them unset and the frontend initialises no analytics and
# loads no third-party script. Set them to your own OpenPanel instance — and add
# your hostname to ANALYTICS_HOSTS in dashboard/index.html — to collect your own.
# VITE_OPENPANEL_API_URL=https://api.openpanel.example.com
# VITE_OPENPANEL_CLIENT_ID=your_openpanel_client_id

# Thumbnail Studio: creative text model (titles, concepts) and the image model.
# Not tied to GEMINI_MODEL on purpose: flash-lite is fine for closed choices,
# visibly worse at titles.
GEMINI_MODEL_THUMBNAIL=gemini-3.7-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Moment picker on your own model instead of Gemini (self-host). Any
# OpenAI-compatible chat endpoint: Ollama, LM Studio, vLLM, llama.cpp,
# LocalAI, OpenRouter. With this set the Gemini key is optional; it is still
# used, if present, for the frame-based stages (layout picker, silent videos).
# Ollama needs a context above its 4096 default: OLLAMA_CONTEXT_LENGTH=16384.
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=
# LLM_SCORE_BATCH=3
# LLM_TIMEOUT=600

# Hard daily ceiling for the per-GB paid proxy (UTC day, MB). Above it,
# DataImpulse is removed from every chain until midnight and the jobs that
# needed it fail with a clear error. 0 disables the cap. Default 500.
# PAID_PROXY_DAILY_MB=500

# --- Clip selection: judges rank, they do not end the job -------------------
# Four judges run in series and each could return an empty list, which failed
# the job with "Clip detection failed". Measured: an English stand-up set
# scored 95-100 and produced 6 clips; a Hinglish one scored 80/40, 30/40,
# 30/20, 60/30 - four candidates that each contained a real joke - and
# produced nothing.
#
# Scores at or above this are good enough to PUBLISH. The old bar was 85 on
# both axes, on a scale whose own prompt calls 90+ "genuinely excellent".
# MEANINGFUL_ACCEPT_FLOOR=70
#
# When nothing clears the bar at all, publish the best of what was found
# (flagged low_confidence) instead of failing. 0 restores the old behaviour.
# MEANINGFUL_ALWAYS_PRODUCE=1
# MEANINGFUL_FALLBACK_MAX=3
#
# The hard duration band. 90s was never a platform limit (Shorts allows 3
# minutes, TikTok 10, Reels 3) - it was an editorial preference enforced as a
# gate, and it deleted a clip whose punchline landed at 107s. The prompts
# still ask for 25-60s.
# MEANINGFUL_MIN_CLIP_SECONDS=15
# MEANINGFUL_MAX_CLIP_SECONDS=110

# --- Remote transcription on Kaggle (kaggle_worker.py) ----------------------
# Transcription is the long pole: ~16 min of CPU for a 9.5-minute video here,
# seconds on a GPU. It is also the only stage whose input is small (a URL) and
# whose output is small (a JSON transcript), so it is the only one worth
# shipping off the machine — the render needs the video file.
#
# Kaggle runs BATCH kernels: nothing can call a running kernel. The backend
# pushes a version with the URL baked in, polls for COMPLETE, and downloads
# transcript.json. Expect 3-8 minutes wall clock, dominated by queue and boot.
#
# STRICTLY an accelerator. No credentials, no GPU quota, a kernel error, a
# timeout, or a transcript that fails the quality gate all fall through to
# local ASR. A job never fails because Kaggle was busy.
#
# Setup, once:
#   python tools/kaggle_setup.py cache          # warm cache (several minutes)
#   python tools/kaggle_setup.py test <url>     # one real job, end to end
#
# KAGGLE_USERNAME=your-kaggle-username
# KAGGLE_KEY=...            # KAGGLE_API_TOKEN is accepted as an alias
#
# KAGGLE_ASR=0 disables it entirely and always transcribes locally.
# KAGGLE_GPU=0 runs the kernel on CPU — honest warning, that is no faster
# than doing it here, and it still costs the round trip.
# KAGGLE_KERNEL=<user>/openshorts-asr-worker
# KAGGLE_CACHE_KERNEL=<user>/openshorts-asr-cache
# The Kaggle default is large-v3, NOT turbo. The GPU erases both reasons the
# local path excludes it (~1.8x turbo's CPU decode, and an OOM on load), and on
# 36s of a Hinglish stand-up it scored avg_logprob -0.187 against turbo's
# -0.944, taking three sampled slices from 30% BAD to 0%.
# KAGGLE_WHISPER_MODEL=large-v3
#
# Language is AUTO: the transcription model decides. The small-model probe
# still runs as a cross-check and logs a LANGUAGE DISAGREEMENT when the two
# differ — that is the one failure nothing downstream can catch, because a
# mis-detected language produces a fluent TRANSLATION that scores ~99/100.
# KAGGLE_PIN_LANGUAGE=1   makes the probe binding again
# KAGGLE_DETECT_LANGUAGE=0 skips the probe entirely (no cross-check)
# KAGGLE_TIMEOUT_SECONDS=1800
# How long to wait for a GPU to be ALLOCATED, separately from how long the
# work may then take. QUEUED means nothing is happening and Kaggle publishes
# no queue position, so a long wait there is pure loss - measured: 30 minutes
# of polling followed by the local transcription that could have started at
# once. The clock starts at dispatch, before the local download.
# KAGGLE_QUEUE_TIMEOUT_SECONDS=480
#
# The kernel downloads the SOURCE VIDEO as well and PUTs it to B2, so a
# server whose own download YouTube refuses can take that copy instead
# (source_rescue.py). Needs the B2_* settings below; on by default when they
# are present. Give the kaggle-source/ prefix a 1-day lifecycle rule.
# KAGGLE_SOURCE_RESCUE=0
# KAGGLE_SOURCE_URL_TTL=10800
# KAGGLE_POLL_SECONDS=15

# --- Encoding speed ---------------------------------------------------------
# The x264 preset for every "burn a filter over a finished clip" pass (hook,
# captions, editor effects, passthrough). At a fixed CRF the preset trades
# SPEED against bitrate efficiency; CRF holds quality. Measured on a real
# 55.7s 1080x1920 clip at crf 18: medium 144.3s/28.8MB/SSIM 0.99756,
# fast 115.2s/30.3MB/0.99755, veryfast 55.0s/26.5MB/0.99650.
# FFMPEG_PRESET_QUALITY=veryfast

# --- Burned-in text: script and language ------------------------------------
# Captions are TRANSLITERATED into the Latin alphabet, never translated:
# "मैंने वह किया" is burned as "maine wah kiya", so the words stay the
# speaker's. It is a Gemini call (~4 for a 10-minute video) because a
# deterministic romaniser cannot read the English loanwords that code-switched
# speech writes in a non-Latin script — unidecode turns "फ्लाइट" into
# "phlaaitt", where the correct answer is "flight". Any word the model fails
# on keeps its original script; nothing ever loses its caption timing.
# CAPTION_SCRIPT=original turns it off and burns the speaker's own script.
# CAPTION_SCRIPT=latin
# GEMINI_TRANSLITERATE_MODEL=gemini-3.1-flash-lite
#
# The hook and title are written in ENGLISH. The hook is burned by PIL with a
# single font file and PIL has no fontconfig fallback, so a glyph that font
# lacks is a tofu box — a Hindi hook shipped as ☐☐☐☐ on 20-sep-2026. Set
# METADATA_LANGUAGE=speaker for a deployment whose creators publish in
# Spanish, Portuguese or any other Latin-script language, where English
# metadata over native-language audio is a regression rather than a fix.
# METADATA_LANGUAGE=english

# --- Self-hosted Instagram poster (instagram_publish.py) --------------------
# A second publishing destination beside Upload-Post, for a deployment that
# owns its own Meta app. Clips go to Backblaze B2; only the object KEY goes to
# the poster's Supabase project, which mints a fresh presigned GET at publish
# time and lets Instagram fetch the video itself.
#
# B2 rather than Supabase Storage because that bucket caps files at 50 MB and
# real clips out of this pipeline measured up to 55 MB. Leave any of these
# unset and the destination simply is not offered in the scheduling modal.
# B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# B2_BUCKET=Memefreak
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_REGION is derived from the endpoint host (s3.<region>.backblazeb2.com);
# set it only for an S3-compatible endpoint that does not follow that shape.
# B2_REGION=us-east-005
#
# The poster's ingest Edge Function, and the shared secret it checks. This is
# the ONLY credential the two systems share: the Supabase service-role key
# never leaves Supabase.
# IG_INGEST_URL=https://<project>.supabase.co/functions/v1/ingest-post
# IG_INGEST_SECRET=
#
# Only needed when ingest-post was deployed WITHOUT --no-verify-jwt (a
# dashboard deploy leaves JWT verification on). Supabase's gateway then refuses
# the request before the function runs, with a 401 that reads
# UNAUTHORIZED_NO_AUTH_HEADER and looks exactly like a wrong secret. The anon
# key satisfies that gate; it is public by design and is NOT the authorisation
# here — IG_INGEST_SECRET still is. Redeploying with --no-verify-jwt is the
# tidier fix and makes this unnecessary.
# IG_INGEST_ANON_KEY=

# --- Crediting the source creator (attribution.py) --------------------------
# Clips cut from someone else's video carry a credit line in the Instagram
# caption, placed above the hashtags so it is readable rather than buried in
# the tag block. {credit} is the creator's @handle when one is known and their
# name otherwise; {name} and {url} are also available.
# CREDIT_TEMPLATE=🎥 Original: {credit}
#
# The @handle is only ever one the creator published in their own video
# description — a YouTube handle is NOT an Instagram handle, and an @mention
# naming the wrong person publicly tags a stranger. A description listing ONE
# account costs nothing and is used as-is.
#
# When it lists several (the creator's and the venue's, say) telling them
# apart means reading the words around them, which is a Gemini call. That is
# OPT-IN, because this pipeline already spends heavily on Gemini per video and
# one more call for a nicety is not obviously worth a free-tier quota. Off,
# the credit names the creator in words, which tags nobody and is never wrong.
# CREDIT_PICK_HANDLE=1
#
# POST /api/instagram/schedule takes "credit": false to publish without one.

# --- Linux host: the uid the backend container runs as ----------------------
# docker-compose bind-mounts the checkout over /app, and on Linux that mount
# carries REAL ownership — so the container has to run as the user that owns
# the files or it cannot write to them. Docker Desktop (Windows/macOS) fakes
# ownership and ignores all of this.
#
# CHECK `id -u` RATHER THAN TRUSTING THE 1000 DEFAULT. 1000 is the first
# non-system uid on a clean Ubuntu/Debian/Fedora, but an image that created
# its own account takes it first: on an Oracle Cloud Ubuntu instance the cloud
# agent holds 1000 and `ubuntu` is 1001. Wrong value = `POST /api/process`
# 500s on makedirs() before the job exists, so there is no job directory and
# no log — just "Internal Server Error" in the UI.
#
#   printf "HOST_UID=%s\nHOST_GID=%s\n" "$(id -u)" "$(id -g)" >> .env
#   sudo chown -R "$(id -u):$(id -g)" output uploads
#
# HOST_UID=1000
# HOST_GID=1000
